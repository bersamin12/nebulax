# NEBULA X - local secrets. Copy to `.env` at the repo root and fill in.
# `.env` is git-ignored and must never be committed; this example file has no secrets.
#
# Used by nebulax/advisory/: with a key, POST /api/advisory/{episode_id} asks
# claude-opus-5 for the advisory; without one it silently returns the deterministic
# "template-v1" advisory instead, so the demo runs fine with this file absent.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: point the SDK at a proxy or a gateway. Leave unset for the public API.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
